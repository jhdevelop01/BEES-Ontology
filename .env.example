# ─────────────── Neo4j (기존 neo4j-bees 컨테이너) ───────────────
NEO4J_URI=bolt://host.docker.internal:7689
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ─────────────── InfluxDB ───────────────
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=changeme
INFLUXDB_ORG=samsung-gec
INFLUXDB_BUCKET=raw_7d

# ─────────────── PostgreSQL ───────────────
DATABASE_URL=postgresql://bees:changeme@postgres:5432/bees_platform

# ─────────────── MQTT ───────────────
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# ─────────────── OpenAI ───────────────
OPENAI_API_KEY=changeme
OPENAI_MODEL=gpt-4o

# ─────────────── Grafana ───────────────
GRAFANA_PORT=3001

# ─────────────── JWT ───────────────
JWT_SECRET=changeme

# ─────────────── Inter-Service URLs ───────────────
SERVER_B_URL=http://server-b:8001
SERVER_C_URL=http://server-c:8002
SERVER_D_URL=http://server-d:8003

# ─────────────── 알림 채널 (Email / Slack) ───────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=changeme
SMTP_FROM=noreply@bees.dev
SMTP_USE_TLS=true
SLACK_WEBHOOK_URL=
