    brick:isFedBy bldg:Water_Supply_Pump_1 ;
    brick:isPartOf bldg:Samsung_GEC .

bldg:Samsung_GEC a brick:Site ;
    rdfs:label "Samsung Global Engineering Center (GEC)" ;
    rdfs:comment "서울특별시 강동구 상일로6길 26 (상일동 500). B동 온톨로지의 상위 사이트 컨텍스트." ;
    bees:completionYear "2012" ;
    bees:constructedBy "삼성엔지니어링(주) (박기석) - 직영시공" ;
    bees:designArchitect "HOK (국제설계공모 당선)" ;
    bees:hasConfidence "confirmed" ;
    bees:localArchitect "삼우종합건축사사무소 (손명기)" ;
