    rdfs:label "Month Name" .

bees:monthValue_kWh a owl:DatatypeProperty ;
    rdfs:label "Monthly Energy Value (kWh)" .

bees:networkLayer a owl:DatatypeProperty ;
    rdfs:label "Network Layer" .

bees:occupantCount a owl:DatatypeProperty ;
    rdfs:label "Occupant Count" .

bees:operationalEUI_kWh_m2 a owl:DatatypeProperty ;
    rdfs:label "Operational EUI (kWh/m2/year)" .

bees:parkingCount a owl:DatatypeProperty ;
    rdfs:label "Parking Spaces Count" .

bees:pointCount a owl:DatatypeProperty ;
