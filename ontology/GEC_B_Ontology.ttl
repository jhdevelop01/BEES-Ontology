bldg:Energy_Cooling a bees:EnergyBreakdown ;
    rdfs:label "냉방 에너지 소요량" ;
    rdfs:comment "전체의 ~36%. 칠드실링+UFAD 복합냉방. 대형 오피스 내부발열 큼." ;
    bees:estimatedRange "95~110 kWh/m2*년" ;
    bees:hasConfidence "estimated" ;
    bees:inferenceSource "에너지효율등급 분해, 벤치마킹" ;
    bees:unit "kWh/m2*년" ;
    bees:value 103.0 ;
    brick:isPointOf bldg:GEC_Tower_B .

