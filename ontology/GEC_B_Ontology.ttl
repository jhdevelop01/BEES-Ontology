    rdfs:label "냉방 에너지 소요량" ;
    rdfs:comment "BEMS 실측 기반. 칠드실링+UFAD 복합냉방." ;
    bees:hasConfidence "confirmed" ;
    bees:dataSource "GEC BEMS 실측 (2024년)" ;
    bees:measurementPeriod "2024-01-01/2024-12-31" ;
    bees:unit "kWh/m2*년" ;
    bees:value 99.2 ;
    brick:isPointOf bldg:GEC_Tower_B .

