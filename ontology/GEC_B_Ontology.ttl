# SECTION 2: LOCATION — Site / Building
# =============================================================================

bldg:GEC_Tower_B a brick:Building ;
    rdfs:label "GEC Tower B (14층)" ;
    rdfs:comment "14층 (4층/13층 없음), 삼성물산 건설부문 임차 (2018.03~)" ;
    rdfs:comment "기준층 층고 4.0m (UFAD 이중바닥 350mm + 사무공간 2.7m + 천장플레넘 950mm). 1F 로비 층고 5.5m 추정. 지하 층고 3.8m. DSF 적용구간: 서향 5F~15F." ;
    bees:annualEnergyEstimate_TOE 1984.0 ;
    bees:annualEnergyEstimate_kWh 23074000.0 ;
    bees:annualGHGEmission_tCO2eq 3770.0 ;
    bees:buildingOwner "삼성E&A" ;
    bees:ceilingHeight_m 2.7 ;
    bees:certification "녹색건축인증(G-SEED) 최우수등급 (LH, 2012.04.19)" ;
    bees:certification "스마트그린빌딩 1등급" ;
    bees:certification "에너지효율등급 1등급" ;
    bees:certification "지능형건축물(IBS) 1등급" ;
    bees:certification "초고속정보통신 특등급" ;
    bees:energyReductionRate 40.0 ;
    bees:floorHeight_m 4.0 ;
    bees:grossFloorArea 61700.0 ;
    bees:hasConfidence "confirmed" ;
    bees:occupantCount 2000 ;
    bees:operationalEUI_kWh_m2 384.0 ;
    bees:primaryEnergyConsumption 287.4 ;
    bees:raisedFloorHeight_mm 350.0 ;
    bees:tenant "삼성물산 건설부문" ;
    brick:hasPart bldg:B_10F ;
    brick:hasPart bldg:B_11F ;
