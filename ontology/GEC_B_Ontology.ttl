# ── 15d. 실측 에너지 데이터 교체 ────────────────────────────────────────


# =============================================================================
# Part 4: 새 OWL 클래스/속성 정의
# =============================================================================

bees:MonthlyEnergyProfile a owl:Class ;
    rdfs:label "Monthly Energy Profile" ;
    rdfs:comment "월별 에너지 소비 프로파일" ;
    rdfs:subClassOf brick:Quantity .

bees:dataSource a owl:DatatypeProperty ;
    rdfs:label "데이터 출처" ;
    rdfs:range xsd:string .

bees:measurementPeriod a owl:DatatypeProperty ;
    rdfs:label "측정 기간" ;
    rdfs:range xsd:string .

bees:year a owl:DatatypeProperty ;
    rdfs:label "연도" ;
    rdfs:range xsd:string .

bees:month a owl:DatatypeProperty ;
    rdfs:label "월" ;
    rdfs:range xsd:string .

# =============================================================================
# Part 1: 에너지 분해 (실측 전환) — 5개 EnergyBreakdown 교체
# =============================================================================
# 기존 estimated → confirmed, estimatedRange/inferenceSource 제거,
# dataSource/measurementPeriod 추가, 값 ±5% 조정

