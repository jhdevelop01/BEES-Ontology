# =============================================================================

# ── 15c. 장비 메타데이터 강화 ──────────────────────────────────────────

# =============================================================================
# 장비 메타데이터 강화 — 제조사/모델/시리얼/설치일/보증/정비/정격전력
# 생성일: 2026-02-17
# =============================================================================

# -----------------------------------------------------------------------------
# Part 1: New OWL Property Definitions (SECTION 1에 추가)
# 기존: bees:manufacturer, bees:modelSeries — 이미 존재
# 신규: modelNumber, serialNumber, installationDate, warrantyExpiry,
#       lastMaintenanceDate, ratedPower_kW
# -----------------------------------------------------------------------------

bees:modelNumber a owl:DatatypeProperty ;
    rdfs:label "모델번호" ;
    rdfs:comment "장비 모델 번호." ;
    rdfs:domain brick:Equipment ;
    rdfs:range xsd:string .

bees:serialNumber a owl:DatatypeProperty ;
    rdfs:label "시리얼번호" ;
    rdfs:comment "장비 시리얼 번호. 패턴: KR-GEC-{장비코드}{번호}-{설치연도}." ;
    rdfs:domain brick:Equipment ;
    rdfs:range xsd:string .

bees:installationDate a owl:DatatypeProperty ;
    rdfs:label "설치일" ;
    rdfs:comment "장비 설치 완료일." ;
    rdfs:domain brick:Equipment ;
    rdfs:range xsd:date .

bees:warrantyExpiry a owl:DatatypeProperty ;
    rdfs:label "보증만료일" ;
    rdfs:comment "제조사 보증 만료일 (설치일 + 5년)." ;
    rdfs:domain brick:Equipment ;
    rdfs:range xsd:date .

bees:lastMaintenanceDate a owl:DatatypeProperty ;
    rdfs:label "최근정비일" ;
    rdfs:comment "가장 최근 정기 유지보수 완료일." ;
    rdfs:domain brick:Equipment ;
    rdfs:range xsd:date .

bees:ratedPower_kW a owl:DatatypeProperty ;
    rdfs:label "정격전력 (kW)" ;
    rdfs:comment "장비 정격 소비전력 (kW)." ;
    rdfs:domain brick:Equipment ;
    rdfs:range xsd:decimal .


