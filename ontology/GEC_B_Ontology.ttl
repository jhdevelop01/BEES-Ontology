    rdfs:label "LEED Maximum Score (points)" .

bees:leedScore a owl:DatatypeProperty ;
    rdfs:label "LEED Score (points)" .

bees:leedVersion a owl:DatatypeProperty ;
    rdfs:label "LEED Certification Version" .

bees:localArchitect a owl:DatatypeProperty ;
    rdfs:label "Local Architect" .

bees:manufacturer a owl:DatatypeProperty ;
    rdfs:label "Equipment Manufacturer" .

bees:modelSeries a owl:DatatypeProperty ;
    rdfs:label "Model Series" .

