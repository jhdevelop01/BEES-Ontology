bees:ghgIntensity_tCO2_m2 a owl:DatatypeProperty ;
    rdfs:label "GHG Intensity per Area (tCO2/m2)" .

bees:grossFloorArea a owl:DatatypeProperty ;
    rdfs:label "Gross Floor Area (m2)" .

bees:gseedCategory a owl:DatatypeProperty ;
    rdfs:label "G-SEED Category" .

bees:hasConfidence a owl:DatatypeProperty ;
    rdfs:label "Data Confidence Level" ;
    rdfs:comment "데이터 신뢰도: confirmed(확인), estimated(추정), inferred(법규/기준 역추론)." .

bees:heatingCapacity_Mcal a owl:DatatypeProperty ;
    rdfs:label "Heating Capacity (Mcal/h)" .

bees:inferenceSource a owl:DatatypeProperty ;
    rdfs:label "Inference Source" ;
    rdfs:comment "추정 근거 (예: '건축법규', '벤치마킹', '학술논문')." .

bees:landscapeArea a owl:DatatypeProperty ;
    rdfs:label "Landscape Area (m2)" .

bees:leedCategory a owl:DatatypeProperty ;
    rdfs:label "LEED Category" .

bees:leedCertDate a owl:DatatypeProperty ;
    rdfs:label "LEED Certification Date" .

