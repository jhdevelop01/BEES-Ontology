# =============================================================================
# SECTION 30: Water Treatment Refined (Phase 5 — 미확보 #12)
# =============================================================================
# 중수처리 용량 계산:
#   재실 인원: ~2,000명
#   1인당 상수 사용량: 100 L/일 (업무시설 표준)
#   총 상수 사용량: 200 m³/일
#   발생 배수량: 200 × 0.80 = 160 m³/일
#   중수 처리 가능량: 배수 × 0.40 = 64 m³/일 (생물처리+여과+UV)
#   빗물 수집: 옥상 ~2,000 m² × 1,400 mm/년 = ~2,800 m³/년 → 월 평균 233 m³
#   중수 사용처: 화장실 세정수(40%), 조경관수(30%), 냉각탑보급수(20%), 청소(10%)
#   저장탱크: 1~2일분 = 64~128 m³ → ~100 m³

bldg:Wastewater_Treatment
    bees:estimatedRange "처리용량 64 m³/일, 저장탱크 ~100 m³" ;
    rdfs:comment "생물처리(MBR) + 모래여과 + 활성탄 + UV소독 추정. 2,000명 × 100L/일 = 200 m³/일 중 64 m³ 중수 전환. 화장실 세정(40%) + 조경(30%) + 냉각탑(20%) + 청소(10%)." ;
    bees:inferenceSource "수도법 시행령 제34조, 공학적 물수지 계산" .

bldg:Wastewater_Treatment_Tank a brick:Equipment ;
    rdfs:label "중수 저장탱크 (추정 ~100 m³)" ;
    rdfs:comment "1~2일 저장 용량. 지하 설치 추정. FRP 또는 콘크리트 수조." ;
    bees:capacity "~100 m³" ;
    bees:hasConfidence "estimated" ;
    bees:inferenceSource "중수 처리량 64 m³/일 × 1.5일분" ;
    brick:isPartOf bldg:Wastewater_Treatment .

bldg:Rainwater_Storage_Tank a brick:Equipment ;
    rdfs:label "우수 저류조 (추정 ~50 m³)" ;
    rdfs:comment "빗물 수집 후 1차 저류. 생태연못/조경 관수용. 옥상 ~2,000m² 집수." ;
    bees:capacity "~50 m³" ;
    bees:hasConfidence "estimated" ;
    bees:inferenceSource "빗물이용시설 설치 기준 (연면적 60,000m² 이상)" ;
    brick:isPartOf bldg:Rainwater_System .

# =============================================================================
# SECTION 31: Elevator B동 Refined (Phase 5 — 미확보 #13)
# =============================================================================
# 엘리베이터 대수 재산정 (B동 전용):
#   기존: GEC 전체 32승용+5비상 = 37대
#   B동 단독 재산정 (5분 수송능력 계산):
#     재실 인원: ~2,000명
#     5분 피크 수요: 2,000 × 12% = 240명
#     엘리베이터 사양: 1,150 kg (17인승), 속도 2.5 m/s (14층 기준)
#     왕복시간(RTT): 약 90초 (14층, 2.5 m/s, 층고 4.0m)
#     대당 5분 수송: (17 × 0.8 × 300) / 90 = ~45명
#     필요 대수: 240 / 45 = 5.3 → 최소 6대, 여유 포함 8대
#   결론: B동 승용 8대 + 화물 1대 + 비상 1대 = 10대
#
#   주의: 기존 "32+5=37대"는 GEC 전체(A/B/C 3개동+포디움) 기준
#   B동 배분율: 37 × 32.3% = ~12대 → 10대는 보수적 추정으로 합리적

# --- 기존 엘리베이터 그룹 수정 (B동 전용) ---
bldg:Elevator_Group_Passenger
    rdfs:label "B동 승용 엘리베이터 (추정 8대)" ;
    rdfs:comment "B동 전용 8대 추정. 1,150kg/17인, 속도 2.5m/s. 5분 수송능력: 8×45=360명 (12% 피크 240명 충족). 제조사: 현대/오티스/미쓰비시 중 택1 추정." ;
    bees:estimatedRange "8대, 1,150kg/17인, 2.5 m/s" ;
    bees:hasConfidence "estimated" ;
    bees:inferenceSource "5분 수송능력 계산 (ASHRAE/건축설비 기준)" ;
    bees:manufacturer "현대엘리베이터/Otis/Mitsubishi (추정)" .

bldg:Elevator_Group_Emergency
    rdfs:label "B동 비상/화물 엘리베이터 (추정 2대)" ;
    rdfs:comment "화물 1대(2,000kg) + 비상용 1대(1,600kg). 소방법 비상용 승강기 의무(11층 이상)." ;
    bees:estimatedRange "2대 (화물 1 + 비상 1)" ;
    bees:hasConfidence "estimated" ;
    bees:inferenceSource "소방시설법 (11층 이상 비상용 승강기), 화물수송 표준" .

# =============================================================================
# SECTION 32: Monthly Energy Profile — BEMS Proxy (Phase 5 — 미확보 #14)
# =============================================================================
# 월별 에너지 배분 추정 근거:
#   연간 EUI: 384 kWh/m²/년 (실운영, 서울시 에너지다소비건물 기반)
#   B동 연간 총: 23,074,000 kWh = 23,074 MWh
#   서울 기후 패턴: 여름(7~8월) 냉방 피크, 겨울(12~2월) 난방 피크
#   월별 배분비율(서울 대형 업무시설 표준):
#     Jan:10.2%, Feb:9.1%, Mar:7.8%, Apr:6.8%, May:6.3%, Jun:7.8%
#     Jul:10.4%, Aug:10.9%, Sep:8.3%, Oct:6.8%, Nov:7.3%, Dec:8.3%
#   합계: 100.0%

bldg:Monthly_Energy_Jan a bees:Monthly_Energy_Profile ;
    rdfs:label "1월 에너지 소비 추정" ;
    bees:monthName "January" ;
    bees:monthValue_kWh "2354000"^^xsd:decimal ;
    rdfs:comment "난방 피크. 전체의 10.2%." ;
    bees:hasConfidence "estimated" ;
    bees:inferenceSource "서울 기후 기반 월별 에너지 배분 (HDD 2,700)" ;
    brick:isPointOf bldg:GEC_Tower_B .

bldg:Monthly_Energy_Feb a bees:Monthly_Energy_Profile ;
    rdfs:label "2월 에너지 소비 추정" ;
    bees:monthName "February" ;
