# =============================================================================
# SECTION 2: SYSTEM 정의
# =============================================================================

bldg:HVAC_System a brick:HVAC_System ;
    rdfs:label "GEC B동 HVAC 시스템" ;
    rdfs:comment "3중 복합 공조: UFAD + 칠드실링 + 복사난방. 약 40% 에너지 절감 (HOK 설계)." ;
    brick:hasLocation bldg:GEC_Tower_B ;
    brick:hasPart bldg:Chiller_Plant ,
                  bldg:Boiler_Plant ,
                  bldg:UFAD_System ,
                  bldg:CC_System ,
                  bldg:RH_System ,
                  bldg:DSF_System ,
                  bldg:NP_System .

bldg:UFAD_System a bees:UFAD_System ;
    rdfs:label "가압식 바닥공조 시스템 (UFAD)" ;
    rdfs:comment "이중바닥 하부 가압 플레넘을 통한 바닥 급기. 급기온도 18~20도C. 환기효율 20%+ 향상." ;
    brick:isPartOf bldg:HVAC_System .

bldg:CC_System a bees:Chilled_Ceiling_System ;
    rdfs:label "칠드실링 복사냉방 시스템" ;
    rdfs:comment "구리배관 내장 천장패널, 16도C 냉수 순환 복사냉방. PMV -0.1~0.42 (MDPI 논문)." ;
    bees:chilledWaterTemp "16"^^xsd:decimal ;
    brick:isPartOf bldg:HVAC_System .

bldg:RH_System a bees:Radiant_Heating_System ;
    rdfs:label "복사난방 시스템" ;
    rdfs:comment "온수 순환 복사패널 난방." ;
    brick:isPartOf bldg:HVAC_System .

bldg:DSF_System a bees:Double_Skin_Facade_System ;
    rdfs:label "이중외피 시스템 (서향)" ;
    rdfs:comment "서향 입면 이중외피. 야간냉각, 겨울 단열, 자연환기." ;
    brick:hasLocation bldg:B_5F_Perimeter_West ;
    brick:isPartOf bldg:HVAC_System .

bldg:NP_System a bees:Night_Purge_System ;
    rdfs:label "야간 외기냉방 시스템" ;
    rdfs:comment "외기온도 조건부 댐퍼 개방으로 슬래브 축냉. 냉방부하 ~21% 절감 (학술논문)." ;
    brick:isPartOf bldg:HVAC_System .

bldg:Lighting_System a brick:Lighting_System ;
    rdfs:label "GEC B동 조명 시스템" ;
    brick:hasLocation bldg:GEC_Tower_B .

bldg:LS_System a bees:Light_Shelf_System ;
    rdfs:label "가변형 외부 라이트셀프 시스템" ;
    rdfs:comment "일조량 수확. 여름 태양열 저감, 겨울 태양열 최대화. LEED IEQc8 자연채광." ;
    brick:isPartOf bldg:Lighting_System .

bldg:BAS a brick:Building_Automation_System ;
    rdfs:label "자동화 디지털 네트워크 시스템" ;
    rdfs:comment "외기/실내/에너지비용 통합 모니터링 및 연속적 자동 조정. 지능형건축물 1등급. BMS 제조사/프로토콜 미확인." ;
    brick:hasLocation bldg:GEC_Tower_B .

bldg:Water_System a brick:Water_System ;
    rdfs:label "GEC 수자원 시스템" ;
    brick:hasLocation bldg:Samsung_GEC ;
    brick:hasPart bldg:Rainwater_System .

bldg:Rainwater_System a bees:Rainwater_Harvesting_System ;
    rdfs:label "우수(빗물) 중수 재활용 시스템" ;
    rdfs:comment "빗물을 중수화하여 생태연못 용수 및 조경 관수로 활용. G-SEED/LEED WE 크레딧 연계. 처리용량/저장탱크 미확인 (Phase 2 요청 B-21)." ;
    brick:isPartOf bldg:Water_System .

bldg:Water_Usage_Meter a bees:Water_Usage_Sensor ;
    rdfs:label "건물 용수 사용량 계측기" ;
    rdfs:comment "상수/중수/빗물 구분 사용량. 연간/월별 데이터 미확보 (Phase 2 요청 G-5)." ;
    bees:waterSourceType "상수, 중수(빗물)" ;
    brick:isPointOf bldg:Water_System .

