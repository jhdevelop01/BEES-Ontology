# =============================================================================
# SECTION 22: Enhanced Inter-System Relationships (Phase 3)
# =============================================================================
# Brick Schema feeds/monitors 관계 강화
# 시스템 간 에너지/유체 흐름 및 제어 관계 명시

# --- 열원 → 공조 시스템 feeds 관계 ---
bldg:Chiller_Plant
    brick:feeds bldg:CC_System ,
                bldg:UFAD_System .

bldg:Boiler_Plant
    brick:feeds bldg:RH_System .

# --- AHU/DOAS → Zone feeds 관계 확장 ---
bldg:AHU_UFAD_2
    brick:feeds bldg:B_6F_Interior_Zone ,
                bldg:B_6F_Perimeter_West ,
                bldg:B_6F_Perimeter_East ,
                bldg:B_6F_Perimeter_South ,
                bldg:B_6F_Perimeter_North ;
    brick:isFedBy bldg:Chiller_1 .

bldg:AHU_UFAD_3
    brick:feeds bldg:B_7F_Interior_Zone ,
                bldg:B_7F_Perimeter_West ,
                bldg:B_7F_Perimeter_East ,
                bldg:B_7F_Perimeter_South ,
                bldg:B_7F_Perimeter_North ;
    brick:isFedBy bldg:Chiller_1 .

bldg:DOAS_1
    brick:feeds bldg:UFAD_System ;
    brick:isFedBy bldg:Chiller_1 .

bldg:DOAS_2
    brick:feeds bldg:UFAD_System ;
    brick:isFedBy bldg:Chiller_1 .

# --- DSF ↔ Night Purge 연계 ---
bldg:DSF_System
    brick:feeds bldg:NP_System .

# --- BAS monitors 관계 (모든 시스템 통합 모니터링) ---
bldg:BAS
    brick:hasPart bldg:DDC_Controller_Group ;
    brick:isPartOf bldg:GEC_Tower_B .

bldg:HVAC_System
    brick:isPartOf bldg:BAS .

bldg:Lighting_System
    brick:isPartOf bldg:BAS .

bldg:Fire_Safety_System
    brick:isPartOf bldg:BAS .

bldg:Security_System
    brick:isPartOf bldg:BAS .

bldg:Electrical_System
    brick:isPartOf bldg:BAS .

bldg:Water_System
    brick:isPartOf bldg:BAS .

# --- 태양광 → 전기 시스템 feeds ---
bldg:Solar_PV_System
    brick:feeds bldg:Electrical_System .

# =============================================================================
# SECTION 23: Representative Space/Room Model (Phase 5 — 미확보 #1,#3)
# =============================================================================
# 공학적 추정 근거: 기준층 임대면적 5,472m², 전용면적 2,612m² (전용율 47.73%)
# 공용면적 2,860m² = 코어(EV/계단/화장실) + 복도 + 설비공간
# 전용면적 분배: 오픈오피스 80% + 회의실 12% + 서버/통신 3% + 지원공간 5%

