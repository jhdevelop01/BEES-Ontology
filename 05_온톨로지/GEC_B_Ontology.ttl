# =============================================================================
# SECTION 29: DSF Louver Control Sequence (Phase 5 — 미확보 #11)
# =============================================================================
# 제어 시퀀스 근거: 특허 6건 + 학술논문 + ASHRAE Fundamentals
# DSF 루버 제어 = f(외기온도, 캐비티온도, 일사량, 풍속, 강우)

# --- 여름 모드 (Tout > 26°C) ---
bldg:DSF_Control_Summer a bees:DSF_Control_Mode ;
    rdfs:label "DSF 여름 모드 (자연환기/야간냉각)" ;
    rdfs:comment "외기온도 > 26°C: 주간 루버 90° 개방(자연환기), 야간 전개방(야간냉각→슬래브 축냉). 캐비티 과열 방지. 풍속 > 15m/s 시 안전폐쇄." ;
    bees:hasConfidence "estimated" ;
    bees:inferenceSource "특허(이중외피 제어), 학술논문, ASHRAE" ;
    brick:isPointOf bldg:DSF_System .

# --- 겨울 모드 (Tout < 5°C) ---
bldg:DSF_Control_Winter a bees:DSF_Control_Mode ;
    rdfs:label "DSF 겨울 모드 (이중단열)" ;
    rdfs:comment "외기온도 < 5°C: 루버 0° 폐쇄(이중단열). 캐비티 내 정지공기층 = 단열효과. 태양열 집열(캐비티→실내 전달). 난방부하 ~15-20% 저감." ;
    bees:hasConfidence "estimated" ;
    bees:inferenceSource "특허(이중외피 제어), 학술논문" ;
    brick:isPointOf bldg:DSF_System .

# --- 중간기 모드 (5°C ≤ Tout ≤ 26°C) ---
bldg:DSF_Control_Transition a bees:DSF_Control_Mode ;
    rdfs:label "DSF 중간기 모드 (부분 자연환기)" ;
    rdfs:comment "5°C ≤ 외기온도 ≤ 26°C: 루버 30~60° 부분 개방. 외기온도 < 실내온도 시 자연환기 활성화. 일사량 연계 각도 최적화." ;
    bees:hasConfidence "estimated" ;
    bees:inferenceSource "특허(이중외피 제어), 학술논문" ;
    brick:isPointOf bldg:DSF_System .

# --- 안전 모드 ---
