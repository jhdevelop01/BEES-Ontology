bldg:Chiller_Plant a brick:Chiller_Plant ;
    rdfs:label "냉열원 플랜트" ;
    rdfs:comment "칠러, 냉수펌프, 냉각수펌프, 냉각탑 (대수/용량 미확인 - Phase 2 요청)" ;
    brick:isPartOf bldg:HVAC_System ;
    brick:hasPart bldg:Chiller_1 ,
                  bldg:CHW_Pump_1 ,
                  bldg:CW_Pump_1 ,
                  bldg:Cooling_Tower_1 .

bldg:Chiller_1 a brick:Chiller ;
    rdfs:label "칠러 #1" ;
    rdfs:comment "대수/용량(RT)/종류/제조사 미확인. 칠드실링용 16도C + UFAD용 냉수 공급." ;
    brick:isPartOf bldg:Chiller_Plant .

bldg:CHW_Pump_1 a brick:Chilled_Water_Pump ;
    rdfs:label "냉수 순환펌프 #1" ;
    rdfs:comment "변속펌프 (Variable Speed) 추정. 대수/유량/양정 미확인." ;
    brick:isPartOf bldg:Chiller_Plant .

bldg:CW_Pump_1 a brick:Condenser_Water_Pump ;
    rdfs:label "냉각수 순환펌프 #1" ;
    rdfs:comment "대수/유량/양정 미확인." ;
    brick:isPartOf bldg:Chiller_Plant .

bldg:Cooling_Tower_1 a brick:Cooling_Tower ;
    rdfs:label "냉각탑 #1" ;
    rdfs:comment "대수/용량/종류(개방/밀폐) 미확인." ;
    brick:isPartOf bldg:Chiller_Plant .

bldg:Boiler_Plant a brick:Boiler ;
    rdfs:label "온열원 플랜트" ;
    rdfs:comment "보일러, 온수펌프 (대수/용량 미확인 - Phase 2 요청)" ;
    brick:isPartOf bldg:HVAC_System ;
    brick:hasPart bldg:Boiler_1 ,
