                       "초고속정보통신 특등급" ,
                       "스마트그린빌딩 1등급" ;
    bees:primaryEnergyConsumption "287.4"^^xsd:decimal ;
    bees:energyReductionRate "40"^^xsd:decimal ;
    bees:annualEnergyEstimate_kWh "17640000"^^xsd:decimal ;
    bees:annualEnergyEstimate_TOE "1517"^^xsd:decimal ;
    brick:isPartOf bldg:Samsung_GEC ;
    brick:hasPart bldg:B_B4F ,
                  bldg:B_B3F ,
                  bldg:B_B2F ,
                  bldg:B_B1F ,
                  bldg:B_1F ,
                  bldg:B_2F ,
                  bldg:B_3F ,
                  bldg:B_5F ,
