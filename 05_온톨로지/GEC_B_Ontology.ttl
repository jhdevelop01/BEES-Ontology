    rdfs:comment "대수/용량(RT)/종류/제조사 미확인. 칠드실링용 16도C + UFAD용 냉수 공급." ;
    brick:isPartOf bldg:Chiller_Plant .

bldg:CHW_Pump_1 a brick:Chilled_Water_Pump ;
    rdfs:label "냉수 순환펌프 #1" ;
    rdfs:comment "변속펌프 (Variable Speed) 추정. 대수/유량/양정 미확인." ;
    brick:isPartOf bldg:Chiller_Plant .

bldg:CW_Pump_1 a brick:Condenser_Water_Pump ;
    rdfs:label "냉각수 순환펌프 #1" ;
    rdfs:comment "대수/유량/양정 미확인." ;
    brick:isPartOf bldg:Chiller_Plant .

bldg:Cooling_Tower_1 a brick:Cooling_Tower ;
    rdfs:label "냉각탑 #1" ;
    rdfs:comment "대수/용량/종류(개방/밀폐) 미확인." ;
    brick:isPartOf bldg:Chiller_Plant .

bldg:Boiler_Plant a brick:Boiler ;
    rdfs:label "온열원 플랜트" ;
    rdfs:comment "보일러, 온수펌프 (대수/용량 미확인 - Phase 2 요청)" ;
    brick:isPartOf bldg:HVAC_System ;
    brick:hasPart bldg:Boiler_1 ,
                  bldg:HW_Pump_1 .

bldg:Boiler_1 a brick:Boiler ;
    rdfs:label "보일러 #1" ;
    rdfs:comment "대수/용량(kcal/h)/연료/제조사 미확인." ;
    brick:isPartOf bldg:Boiler_Plant .

bldg:HW_Pump_1 a brick:Hot_Water_Pump ;
    rdfs:label "온수 순환펌프 #1" ;
    rdfs:comment "대수/유량/양정 미확인." ;
    brick:isPartOf bldg:Boiler_Plant .

# =============================================================================
# SECTION 4: EQUIPMENT 계층 - UFAD 시스템
# =============================================================================

bldg:AHU_UFAD_1 a brick:AHU ;
    rdfs:label "UFAD 전용 AHU #1" ;
    rdfs:comment "가압식 바닥공조용 공조기. 외기조화기(OAU) 포함 추정. 대수/풍량(CMH) 미확인." ;
    brick:isPartOf bldg:UFAD_System ;
    brick:feeds bldg:B_5F_Interior_Zone ,
                bldg:B_5F_Perimeter_West ,
                bldg:B_5F_Perimeter_East ,
                bldg:B_5F_Perimeter_South ,
                bldg:B_5F_Perimeter_North ;
    brick:isFedBy bldg:Chiller_1 .

bldg:Pressure_Controller_UFAD a brick:Controller ;
    rdfs:label "UFAD 플레넘 압력 제어기" ;
    rdfs:comment "바닥플레넘 정압 제어. 압력센서 피드백 → 급기팬 VFD 제어 (학술논문 확인)." ;
    brick:isPartOf bldg:UFAD_System .

bldg:Floor_Diffuser_5F_Int a bees:Floor_Diffuser ;
    rdfs:label "5F 내주부 바닥 디퓨저" ;
    rdfs:comment "내주부 디퓨저 그룹. 종류(스월/방향조절)/수량 미확인." ;
    brick:hasLocation bldg:B_5F_Interior_Zone ;
    brick:isFedBy bldg:AHU_UFAD_1 .

bldg:Floor_Diffuser_5F_West a bees:Floor_Diffuser ;
    rdfs:label "5F 서향 외주부 바닥 디퓨저" ;
    rdfs:comment "서향 외주부 디퓨저 그룹. DSF 연계." ;
    brick:hasLocation bldg:B_5F_Perimeter_West ;
    brick:isFedBy bldg:AHU_UFAD_1 .

bldg:Floor_Diffuser_5F_East a bees:Floor_Diffuser ;
    rdfs:label "5F 동향 외주부 바닥 디퓨저" ;
    brick:hasLocation bldg:B_5F_Perimeter_East ;
    brick:isFedBy bldg:AHU_UFAD_1 .

