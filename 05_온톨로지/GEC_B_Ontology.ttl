# =============================================================================
# SECTION 24: Building Section Data — Heights (Phase 5 — 미확보 #2)
# =============================================================================
# 공학적 추정 근거:
#   - 14층 건물, 연면적 61,700m² → 기준층 면적 5,472m² × 11층 = 60,192m²
#   - 나머지 ~1,508m² = 지하 기계실/공용 면적 일부
#   - UFAD 이중바닥 필수 → 바닥 플레넘 300-400mm
#   - 칠드실링 → 천장 플레넘 800-1000mm
#   - 일반적 14층 오피스 → 전체 높이 약 60-65m

# --- 층고 데이터 (건물 단면 추정) ---
bldg:GEC_Tower_B
    bees:floorHeight_m "4.0"^^xsd:decimal ;
    bees:ceilingHeight_m "2.7"^^xsd:decimal ;
    bees:raisedFloorHeight_mm "350"^^xsd:decimal ;
    rdfs:comment "기준층 층고 4.0m (UFAD 이중바닥 350mm + 사무공간 2.7m + 천장플레넘 950mm). 1F 로비 층고 5.5m 추정. 지하 층고 3.8m. DSF 적용구간: 서향 5F~15F." .

bldg:B_1F
    bees:floorHeight_m "5.5"^^xsd:decimal ;
    bees:ceilingHeight_m "4.5"^^xsd:decimal ;
    rdfs:comment "로비층. 2개층 높이 아트리움 포함 추정." .

bldg:B_B4F
    bees:floorHeight_m "3.8"^^xsd:decimal ;
    bees:ceilingHeight_m "2.4"^^xsd:decimal .

# --- DSF 적용 구간 상세 ---
bldg:DSF_System
    rdfs:comment "서향 이중외피 적용 구간: 5F~15F (오피스 전층). 캐비티 깊이 600~800mm. 외부루버+내부창문 이중구조. 총 높이 약 44m (11개 층 × 4.0m)." ;
    bees:estimatedRange "캐비티 깊이 600~800mm, 적용높이 ~44m (5F~15F)" ;
    bees:hasConfidence "estimated" ;
    bees:inferenceSource "학술논문 + 특허 (이중외피 설계 표준)" .

# =============================================================================
# SECTION 25: Refined Equipment Specifications (Phase 5 — 미확보 #4,#5)
# =============================================================================
# 공학적 부하 계산 기반 장비 사양 정밀화
#
# 냉방부하 계산:
#   B동 전용면적 기준 냉방: 61,700m² × 150 W/m² = 9,255 kW
#   냉동톤 환산: 9,255 / 3.517 = 2,632 RT
#   다양성 계수 0.75 적용: ~1,974 RT (B동 실소요)
#   GEC 전체: ~186,000 m² × 150 × 0.75 / 3.517 = ~5,950 RT
#   칠러 4대 구성: 4 × 1,500 RT = 6,000 RT (GEC 전체, B동 배분 32.3% = 1,940 RT)
#
# 난방부하 계산:
#   B동: 61,700m² × 80 W/m² = 4,936 kW = 4,245 Mcal/h
#   보일러 2대: 2 × 2,500 Mcal/h = 5,000 Mcal/h (여유율 포함)
#
# AHU 풍량 계산:
#   ASHRAE 62.1 최소 외기: 2,000명 × 10 L/s = 20,000 L/s
#   UFAD 급기: 전용면적 2,612m²/층 × 5 L/s/m² = 13,060 L/s/층 = 47,000 CMH/층
#   AHU 용량: 층당 1대 × 47,000 CMH = 11대 (오피스 전층)
#   DOAS: 외기 100% 처리 = 72,000 CMH 총 → 3대 × 24,000 CMH

# --- 칠러 사양 정밀화 ---
bldg:Chiller_1
    bees:manufacturer "Trane/Carrier (추정, 2012 한국 대형빌딩 주요 공급사)" ;
    bees:modelSeries "원심식 (Centrifugal) 대용량" ;
    bees:coolingCapacity_RT "1500"^^xsd:decimal ;
    rdfs:comment "원심식 대형 칠러. GEC 전체 4대 × 1,500RT = 6,000RT 구성 추정. R-134a 냉매. COP 6.0~6.5 추정." .

bldg:Chiller_2
    bees:manufacturer "Trane/Carrier (추정)" ;
    bees:coolingCapacity_RT "1500"^^xsd:decimal .

bldg:Chiller_3
    bees:manufacturer "Trane/Carrier (추정)" ;
    bees:coolingCapacity_RT "1500"^^xsd:decimal .

bldg:Chiller_4
    bees:manufacturer "Trane/Carrier (추정)" ;
    bees:coolingCapacity_RT "1500"^^xsd:decimal .

# --- 보일러 사양 정밀화 ---
