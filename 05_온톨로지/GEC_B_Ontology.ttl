                  bldg:B_15F ,
                  bldg:B_RF .

bldg:GEC_Tower_C a brick:Building ;
    rdfs:label "GEC Tower C - R&D Building (8층)" ;
    rdfs:comment "8층, 삼성E&A R&D Building, LEED Gold" ;
    bees:buildingOwner "삼성E&A" ;
