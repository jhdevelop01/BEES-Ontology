# =============================================================================
# SECTION 26: BMS Architecture (Phase 5 — 미확보 #6,#8,#9)
# =============================================================================
# BMS 제조사 추론 근거:
#   - 2012년 한국 대형 업무시설 BMS 시장: Honeywell, Siemens, JCI 3강
#   - IBS 1등급 → BACnet 지원 Tier-1 벤더 필수
#   - 삼성E&A 시공 → 삼성SDS Brightics IoT 연계 가능, 그러나 2012년 당시 미출시
#   - Honeywell EBI (Enterprise Buildings Integrator): 2012년 한국 시장점유율 1위 추정
#   - 대안: Siemens Desigo CC, JCI Metasys
#
# DDC 구성 추론:
#   - HVAC Zone 50개 / DDC당 8~16포인트 구간 → 층당 4~7대
#   - AHU 11대 + DOAS 3대 → 전용 DDC 14대
#   - 플랜트(칠러/보일러) 전용 DDC 4~6대
#   - 총: 55~77(존) + 14(AHU) + 5(플랜트) = 74~96대 → 약 80~100대
#
# 네트워크 토폴로지:
#   - Level 1 (감독층): BACnet/IP over Ethernet 1Gbps → BMS 서버/워크스테이션
#   - Level 2 (자동화층): BACnet/IP → 층별 네트워크 스위치 → DDC 컨트롤러
#   - Level 3 (필드층): BACnet MS/TP over RS-485 → 센서/액추에이터 직결

# --- BMS 제조사 확정 (추론) ---
bldg:BAS
    bees:manufacturer "Honeywell (추정, EBI 플랫폼)" ;
    bees:modelSeries "Enterprise Buildings Integrator (EBI)" ;
    rdfs:comment "BMS 제조사 Honeywell 추론 (2012 한국 대형빌딩 시장 1위). EBI 플랫폼 기반 BACnet/IP+MS/TP 2계층 아키텍처. 대안: Siemens Desigo CC / JCI Metasys." .

# --- BMS 서버/워크스테이션 ---
bldg:BMS_Server a brick:Server ;
    rdfs:label "BMS 중앙 서버 (추정)" ;
    rdfs:comment "Honeywell EBI 서버. 방재센터 또는 B1F 관리실 설치 추정. 이중화(Redundancy) 구성." ;
    bees:hasConfidence "estimated" ;
    bees:inferenceSource "IBS 1등급, 대형 BMS 표준 구성" ;
    brick:isPartOf bldg:BAS .

bldg:BMS_Workstation a brick:Equipment ;
    rdfs:label "BMS 운영 워크스테이션 (추정 2~3대)" ;
    rdfs:comment "방재센터 모니터링 + 관리사무소 운영용. 그래픽 HMI, 이력 조회, 알람 관리." ;
    bees:hasConfidence "estimated" ;
    bees:estimatedRange "2~3대" ;
    brick:isPartOf bldg:BAS .

# --- 네트워크 토폴로지 (3계층) ---
bldg:BAS_Network_Supervisory a bees:BAS_Network_Layer ;
    rdfs:label "BAS 감독 네트워크 (Level 1)" ;
    rdfs:comment "BACnet/IP over Ethernet. BMS서버 ↔ 워크스테이션 ↔ 웹클라이언트. 1 Gbps 백본." ;
    bees:networkLayer "Level 1 - Supervisory" ;
    bees:protocol "BACnet/IP, Ethernet 1Gbps" ;
    bees:hasConfidence "estimated" ;
    bees:inferenceSource "IBS 1등급, BACnet 표준 아키텍처" ;
    brick:isPartOf bldg:BAS .

bldg:BAS_Network_Automation a bees:BAS_Network_Layer ;
    rdfs:label "BAS 자동화 네트워크 (Level 2)" ;
    rdfs:comment "BACnet/IP over Ethernet. BMS서버 ↔ DDC 컨트롤러. 층별 L2 스위치 연결. 100 Mbps." ;
    bees:networkLayer "Level 2 - Automation" ;
    bees:protocol "BACnet/IP, Ethernet 100Mbps" ;
    bees:hasConfidence "estimated" ;
    brick:isPartOf bldg:BAS .

bldg:BAS_Network_Field a bees:BAS_Network_Layer ;
    rdfs:label "BAS 필드 네트워크 (Level 3)" ;
    rdfs:comment "BACnet MS/TP over RS-485. DDC ↔ 센서/액추에이터 직결. 트렁크당 최대 32장치. 층당 2~4 트렁크." ;
    bees:networkLayer "Level 3 - Field" ;
    bees:protocol "BACnet MS/TP, RS-485" ;
    bees:estimatedRange "층당 2~4 MS/TP 트렁크, 트렁크당 최대 32장치" ;
    bees:hasConfidence "estimated" ;
    bees:inferenceSource "BACnet MS/TP 표준 (ASHRAE 135)" ;
    brick:isPartOf bldg:BAS .

# --- DDC 컨트롤러 계층 구조 정밀화 ---
bldg:DDC_Controller_Group
    bees:estimatedRange "80~100대 총계" ;
    rdfs:comment "존 DDC 55~77대 (층당 5~7) + AHU DDC 14대 + 플랜트 DDC 5대 + 기타 6~4대 = 총 80~100대." .

bldg:DDC_Zone_Controller_Group a brick:Controller ;
    rdfs:label "존 제어용 DDC 그룹 (추정 55~77대)" ;
    rdfs:comment "HVAC Zone 50개 제어. 층당 5~7대. 각 DDC당 8~16 I/O 포인트. 존온도/습도/CO2 입력, 밸브/디퓨저 출력." ;
    bees:hasConfidence "estimated" ;
    bees:estimatedRange "55~77대 (층당 5~7)" ;
    bees:inferenceSource "HVAC Zone 50개 ÷ DDC당 8~16 Zone" ;
    brick:isPartOf bldg:BAS .

bldg:DDC_AHU_Controller_Group a brick:Controller ;
    rdfs:label "AHU 전용 DDC 그룹 (추정 14대)" ;
    rdfs:comment "AHU 11대 + DOAS 3대 = 14대. 각 DDC당 20~30 I/O 포인트. 급/환기온도, 팬속도, 댐퍼, 필터DP." ;
    bees:hasConfidence "estimated" ;
    bees:estimatedRange "14대" ;
    bees:pointCount "20~30 I/O per DDC" ;
    bees:inferenceSource "AHU 1대당 전용 DDC 1대 (표준)" ;
    brick:isPartOf bldg:BAS .

bldg:DDC_Plant_Controller_Group a brick:Controller ;
    rdfs:label "플랜트 전용 DDC 그룹 (추정 5대)" ;
    rdfs:comment "칠러 플랜트 2대, 보일러 플랜트 1대, 냉각탑 1대, 공통 1대. 대용량 I/O." ;
    bees:hasConfidence "estimated" ;
    bees:estimatedRange "5대" ;
    bees:inferenceSource "열원 장비 그룹별 전용 DDC (표준)" ;
    brick:isPartOf bldg:BAS .

# =============================================================================
# SECTION 27: Representative BMS Point List (Phase 5 — 미확보 #7)
# =============================================================================
# BMS 포인트 수량 추정 근거:
#   칠러 4대 × 18포인트 = 72
#   보일러 2대 × 12포인트 = 24
#   AHU 11대 × 22포인트 = 242
#   DOAS 3대 × 15포인트 = 45
#   HVAC Zone 50개 × 6포인트 = 300
#   펌프 15대 × 6포인트 = 90
#   냉각탑 3대 × 8포인트 = 24
#   조명 제어 ~150존 × 3포인트 = 450
#   소방/보안/승강기 = ~200
#   전력계량 = ~80
#   기타(물/태양광 등) = ~50
